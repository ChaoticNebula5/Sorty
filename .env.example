APP_NAME=Sorty AI
APP_ENV=local
# Backend-only owner/admin token. Use Authorization: Bearer <ADMIN_TOKEN>.
# Set this in your backend runtime environment; do not put it in VITE_* frontend env.
ADMIN_TOKEN=demo-admin-token

# Deprecated local/demo compatibility only. Keep disabled unless intentionally testing old clients.
APP_API_KEY=demo-secret
ENABLE_LEGACY_API_KEY=false

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg://sorty:sorty@postgres:5432/sorty
REDIS_URL=redis://redis:6379/0

STORAGE_PROVIDER=minio
STORAGE_ROOT=/app/storage

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sortyadmin
MINIO_SECRET_KEY=sortypassword
MINIO_BUCKET=sorty-media
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

MAX_UPLOAD_SIZE_MB=10
THUMBNAIL_SIZE=300

# Demo/test mode uses mock vision. For local real vision, set VISION_PROVIDER=ollama.
# For Gemini, set VISION_PROVIDER=gemini and GEMINI_API_KEY.
VISION_PROVIDER=ollama
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
# Docker on Windows/Mac can reach host Ollama through host.docker.internal.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_VISION_MODEL=llava

# Functional local default. First use may download the model into the container/cache.
# Use EMBEDDING_PROVIDER=mock only for fast demo/test runs.
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Visual search embeds image pixels with a CLIP-compatible SentenceTransformer.
# This powers searches like "drinks", "buildings", or "shoes" even when captions miss them.
VISUAL_SEARCH_ENABLED=true
VISUAL_EMBEDDING_MODEL=sentence-transformers/clip-ViT-B-32
VISUAL_EMBEDDING_DIMENSION=512
VISUAL_SEARCH_WEIGHT=0.7
VISUAL_SEARCH_MIN_SCORE=0.18

LANGGRAPH_AUTO_SETUP_CHECKPOINTER=false

RQ_QUEUE_NAME=mediaops
JOB_POLL_INTERVAL_SECONDS=2

BLUR_THRESHOLD_BLURRY=80
BLUR_THRESHOLD_ACCEPTABLE=150
PHASH_DUPLICATE_THRESHOLD=6
