APP_NAME=Sorty AI
APP_ENV=local
APP_API_KEY=demo-secret

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

DATABASE_URL=postgresql+psycopg://sorty:sorty@postgres:5432/sorty
REDIS_URL=redis://redis:6379/0

STORAGE_PROVIDER=minio
STORAGE_ROOT=/app/storage

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=sortyadmin
MINIO_SECRET_KEY=sortypassword
MINIO_BUCKET=sorty-media
MINIO_SECURE=false
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=3600

MAX_UPLOAD_SIZE_MB=10
THUMBNAIL_SIZE=300

VISION_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_VISION_MODEL=llava

EMBEDDING_PROVIDER=mock
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
LANGGRAPH_AUTO_SETUP_CHECKPOINTER=false

RQ_QUEUE_NAME=mediaops
JOB_POLL_INTERVAL_SECONDS=2

BLUR_THRESHOLD_BLURRY=80
BLUR_THRESHOLD_ACCEPTABLE=150
PHASH_DUPLICATE_THRESHOLD=6
